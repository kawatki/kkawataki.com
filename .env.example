# Server-only Stripe test credentials. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Server-only BTC custom-request payment settings. The address is revealed only
# after the protected BTC request form is submitted.
BTC_RECEIVING_ADDRESS=bc1qREPLACE_ME
BTC_PAYMENT_NETWORK=Bitcoin mainnet
BTC_EXPLORER_API_URL=https://blockstream.info/api
BTC_MIN_AMOUNT_BTC=0.01
BTC_PENDING_REQUEST_TTL_HOURS=2
BTC_CONFIRMATIONS_REQUIRED=1
BTC_REFUND_POLICY="If the rental does not happen, I will refund the BTC received in full, excluding the Bitcoin network/remittance fee."

# Protects cron endpoints such as /api/cron/cleanup-btc-requests.
CRON_SECRET=replace-with-a-long-random-value

# Create a Google service account, enable Calendar API, and share the booking
# calendar with the service account email using "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_EMAIL=booking-service@example.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Service accounts on personal Gmail calendars may not be able to invite guests.
# Stripe still emails the payment receipt when this is false.
GOOGLE_INVITE_CUSTOMERS=false

# Server-only random value used to pseudonymize rate-limit identifiers.
RATE_LIMIT_SALT=replace-with-a-long-random-value

# Cloudflare Turnstile protects checkout before any calendar hold is created.
# The site key is public; the secret key must remain server-only.
TURNSTILE_SITE_KEY=0x4AAAAAA_REPLACE_ME
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret
TURNSTILE_ALLOWED_HOSTNAME=rental-japanese-guy.kkawataki.chatgpt.site,kkawataki.com,www.kkawataki.com

# Daily selectable range in Japan Standard Time. Customers choose 30-minute
# increments within this range. The system prefers 4-hour sessions, then
# falls back to 3, 2, or 1 hour only when a longer range is unavailable.
BOOKING_DAY_START=09:00
BOOKING_DAY_END=23:00
BOOKING_TRANSPORT_BUFFER_MINUTES=60

# Current month plus this many future calendar months.
BOOKING_MONTHS_AHEAD=6

# Customer-facing service rate. The deposit is 25% of the calculated total.
BOOKING_RATE_JPY_PER_30_MINUTES=1000

SITE_URL=https://kkawataki.com

# Optional. Set only in production so test and local traffic are not measured.
GA_MEASUREMENT_ID=G-REPLACE_ME
